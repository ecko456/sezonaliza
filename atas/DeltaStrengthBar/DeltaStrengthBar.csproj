<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Build:  dotnet build -c Release
    Output: bin/Release/<tfm>/DeltaStrengthBar.dll  -> copy to the ATAS Indicators folder.

    Targets .NET 8: OFT.Rendering is compiled against System.Drawing.Common 8.0, and a
    net8.0 assembly also loads in ATAS builds running on .NET 10. Override if needed:
      dotnet build -c Release -p:AtasTfm=net10.0

    The ATAS DLL folder is auto-detected for default installs. Override with:
      dotnet build -c Release -p:AtasDir="D:\ATAS Platform"
  -->

  <PropertyGroup>
    <AtasTfm Condition="'$(AtasTfm)' == ''">net8.0</AtasTfm>
    <TargetFramework>$(AtasTfm)</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>DeltaStrengthBar</AssemblyName>
    <RootNamespace>DeltaStrength</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup Condition="'$(AtasDir)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">
    <AtasDir>C:\Program Files (x86)\ATAS Platform</AtasDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(AtasDir)' == '' And $([MSBuild]::IsOSPlatform('OSX'))">
    <AtasDir>/Applications/ATAS X.app/Contents/MonoBundle</AtasDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="ATAS.Indicators">
      <HintPath>$(AtasDir)/ATAS.Indicators.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="ATAS.DataFeedsCore">
      <HintPath>$(AtasDir)/ATAS.DataFeedsCore.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Rendering">
      <HintPath>$(AtasDir)/OFT.Rendering.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="OFT.Attributes">
      <HintPath>$(AtasDir)/OFT.Attributes.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Utils.Common">
      <HintPath>$(AtasDir)/Utils.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- System.Drawing.Common: RenderPen/RenderFont expose its types (DashStyle, FontStyle).
       Use ATAS's own copy when present, otherwise the matching NuGet package (compile only). -->
  <ItemGroup Condition="Exists('$(AtasDir)/System.Drawing.Common.dll')">
    <Reference Include="System.Drawing.Common">
      <HintPath>$(AtasDir)/System.Drawing.Common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition="!Exists('$(AtasDir)/System.Drawing.Common.dll')">
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>

</Project>
